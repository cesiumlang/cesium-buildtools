#!/usr/bin/env bash
# direnv: the newest version of each tool installed in opt/ by buildtools.bat;
# nothing for a tool that is not installed. cesium's .envrc sources this one.
source ./utils/newest_opt.sh

# the Vulkan SDK here, never a system-wide one (#7)
if dir=$(newest_opt vulkansdk); then
  export VULKAN_SDK=$dir
  PATH_add "$dir/Bin"
fi

for tool in tree-sitter node direnv; do
  if dir=$(newest_opt "$tool"); then
    PATH_add "$dir"
  fi
done
unset dir tool
